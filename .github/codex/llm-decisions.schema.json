{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "arxiv_id": { "type": "string" },
          "decision": {
            "type": "string",
            "enum": ["strong_recommend", "maybe", "skip", "ingest"]
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "score": { "type": "number" },
          "rationale": { "type": "string" },
          "wiki_connections": {
            "type": "array",
            "items": { "type": "string" }
          },
          "signals_used": {
            "type": "array",
            "items": { "type": "string" }
          },
          "ingest_status": { "type": "string" },
          "ingest_error": { "type": "string" }
        },
        "required": [
          "arxiv_id",
          "decision",
          "confidence",
          "score",
          "rationale",
          "wiki_connections",
          "signals_used"
        ]
      }
    }
  },
  "required": ["decisions"]
}
