# Daily arXiv recommendation preferences. Copy to config/daily-arxiv.yml.
# Secrets belong in repository secrets or .env, never in this file.
hours: 24
categories: [cs.LG, cs.CV, cs.CL, cs.AI, stat.ML]
max_recommendations: 10

email:
  enabled: true

schedule:
  enabled: true
  cron: "17 0 * * *"

profile:
  derive_from_wiki: true
  positive_topics: []
  negative_topics: []
  positive_papers: []
  negative_papers: []

enrichment:
  semantic_scholar: true
  deepxiv: true
  s2_anchor_limit: 5
  s2_candidate_limit: 12
  s2_recommendation_limit: 50
  deepxiv_brief_limit: 8
  deepxiv_trending_days: 7
  deepxiv_trending_limit: 50
