# Example Codex user config snippet for AutoSci.
#
# Codex CLI reads MCP servers from $CODEX_HOME/config.toml, usually
# ~/.codex/config.toml. Copy this snippet into that user config, or run:
#
#   codex mcp add llm-review -- python3 mcp-servers/llm-review/server.py
#
# from the AutoSci project root.

[mcp_servers.llm-review]
command = "python3"
args = ["mcp-servers/llm-review/server.py"]
